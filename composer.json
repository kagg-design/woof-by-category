{
  "name": "kagg-design/woof-by-category",
  "description": "WooCommerce Product Filter (WOOF) extension to display set of filters depending on current product category page.",
  "license": "GPL-2.0-or-later",
  "keywords": [
    "woocommerce",
    "filter",
    "woocommerce product filter",
    "filter category"
  ],
  "homepage": "https://wordpress.org/plugins/woof-by-category/",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "KAGG Design",
      "email": "info@kagg.eu",
      "homepage": "https://kagg.eu/en/"
    }
  ],
  "support": {
    "issues": "https://wordpress.org/support/plugin/woof-by-category"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "platform": {
      "php": "7.4.33"
    },
    "allow-plugins": {
      "kylekatarnls/update-helper": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "require-dev": {
    "10up/wp_mock": "^1.1.1",
    "lucatume/function-mocker": "^2.0.0",
    "phpunit/phpunit": "^9.6.38",
    "squizlabs/php_codesniffer": "^3.13.6",
    "phpcompatibility/php-compatibility": "^9.3.5",
    "phpcompatibility/phpcompatibility-wp": "^2.1.8",
    "wp-coding-standards/wpcs": "^3.4.1"
  },
  "autoload": {
    "psr-4": {
      "KAGG\\WoofByCategory\\": "src/php"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "KAGG\\WoofByCategory\\": "src/php",
      "KAGG\\WoofByCategory\\Tests\\Unit\\": "tests/unit"
    }
  },
  "scripts": {
    "post-install-cmd": "@hooks:install",
    "post-update-cmd": "@hooks:install",
    "hooks:install": "@php .githooks/setup.php",
    "changelog": "@php .github/scripts/update-changelog.php",
    "changelog:check": "@php .github/scripts/update-changelog.php --check",
    "phpcs": "vendor/bin/phpcs --colors --standard=phpcs.xml",
    "unit": "vendor/bin/phpunit"
  }
}
